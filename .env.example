# ローカル開発用の環境変数の見本（本物の秘密情報は絶対に書かない）
# Vercel では、これらを Vercel の画面（Settings → Environment Variables）で設定する。

# PostgreSQL の接続先。Vercel では Neon との連携で自動的に設定される
DATABASE_URL=postgres://postgres@127.0.0.1:5432/sns_dev

# ログインの Cookie に署名するための秘密の文字列（32 文字以上のランダムな文字列）
BETTER_AUTH_SECRET=

# このアプリの URL。ローカルでだけ設定する（Vercel では自動で決まるので設定しない）
BETTER_AUTH_URL=http://localhost:3000

# GitHub の OAuth アプリの値（GitHub の Settings → Developer settings → OAuth Apps で発行）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
